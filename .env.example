# ==============================================================================
# MyVehicleChoice — Backend Environment Variables (.env)
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myvehiclechoice
DB_USERNAME=root
DB_PASSWORD=root

# Optional: Full JDBC connection string override (e.g., for AWS RDS / Azure / GCP Cloud SQL)
# DB_URL=jdbc:mysql://localhost:3306/myvehiclechoice?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&createDatabaseIfNotExist=true

# HikariCP Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2

# JPA & Hibernate Settings
JPA_DDL_AUTO=validate
SHOW_SQL=false

# Flyway Database Migration
FLYWAY_ENABLED=true

# JWT Security & Authentication
JWT_SECRET=MyVehicleChoiceSecureSecretKeyForSigningJwtTokens2026!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
